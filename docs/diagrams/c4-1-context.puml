@startuml
title C4, рівень 1: Контекст
skinparam defaultTextAlignment center
skinparam shadowing false

actor "Клієнт (касир)" as client
actor "Власник кав'ярні" as owner
actor "Адміністратор" as admin

rectangle "Система обробки\nзамовлень кав'ярні" as system #LightBlue
rectangle "Поштовий сервіс\n(Gmail, необов'язково)" as mail #LightGray

client --> system : входить, оформлює замовлення
owner --> system : дивиться графіки
admin --> system : запускає, перевіряє стан
system --> mail : надсилає алерти
@enduml
